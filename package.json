{
  "name": "forge-desktop",
  "version": "0.4.0",
  "private": true,
  "description": "Forge desktop development workspace",
  "main": "dist/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"npm:dev:electron\"",
    "dev:electron": "wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 npm run build:main && electron .",
    "build": "npm run clean && npm run typecheck && npm run build:renderer && npm run build:main",
    "build:renderer": "vite build",
    "build:main": "tsc -p tsconfig.main.json && esbuild src/preload/index.ts --bundle --platform=node --format=cjs --external:electron --outfile=dist/preload/index.cjs",
    "package:win": "npm run native:electron && npm run build && electron-builder --win dir",
    "clean": "node scripts/clean.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.main.json --noEmit",
    "lint": "eslint . --max-warnings=0",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "native:node": "npm rebuild better-sqlite3 node-pty",
    "native:electron": "electron-rebuild --force --only better-sqlite3",
    "test": "npm run native:node && vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "npm run native:node && vitest run tests/integration",
    "test:e2e": "npm run native:electron && npm run build && playwright test",
    "test:packaged": "cross-env FORGE_EXECUTABLE=release/win-unpacked/Forge.exe playwright test",
    "test:database-ui": "node scripts/verify-database-grid.mjs",
    "audit:security": "npm audit --audit-level=moderate",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run audit:security && npm run test:e2e && npm run package:win && npm run test:packaged"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "better-sqlite3": "^12.2.0",
    "monaco-editor": "^0.53.0",
    "mysql2": "^3.23.4",
    "node-pty": "^1.1.0",
    "pg": "^8.23.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^4.0.17"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@playwright/test": "^1.54.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.2.1",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.0",
    "cross-env": "^10.0.0",
    "electron": "^43.3.0",
    "electron-builder": "^26.0.12",
    "eslint": "^9.33.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.39.1",
    "vite": "^7.1.2",
    "vitest": "^3.2.4",
    "wait-on": "^8.0.4"
  },
  "build": {
    "appId": "dev.forge.desktop",
    "productName": "Forge",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "npmRebuild": false,
    "win": {
      "target": "dir"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true,
    "electron@37.10.3": true,
    "esbuild@0.28.2": true,
    "electron-winstaller@5.4.0": true,
    "node-pty@1.1.0": true
  }
}
